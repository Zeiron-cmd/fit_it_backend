# PostgreSQL
POSTGRES_DB=fit_it
POSTGRES_USER=fit_it
POSTGRES_PASSWORD=fit_it_password
DATABASE_URL=postgresql+psycopg2://fit_it:fit_it_password@db:5432/fit_it

# Auth/JWT
JWT_SECRET_KEY=replace_with_long_random_secret
SESSION_SECRET_KEY=replace_with_another_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Public backend URL used for OAuth callback generation.
# Use http://localhost:8000 for local-only testing.
# Use your ngrok URL when frontend runs on another computer.
BACKEND_PUBLIC_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:5173
# Optional: if set, OAuth callback redirects here with access_token and token_type query params.
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:5173/oauth/callback

# OAuth: Google first, then GitHub, then Yandex.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
